## .NET / C# gitignore

# Build outputs
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# NuGet
packages/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/
.nuget/

# Publish output
publish/
[Pp]ublish/
PublishProfiles/*.pubxml.user

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage/

# Rider / JetBrains
.idea/
*.sln.iml

# VS Code
.vscode/
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Backup and log folders created at runtime
Backup - */
Logs - */

# Secrets / environment
*.env
appsettings.local.json
secrets.json

# Internal development / session notes
CONTINUATION_PROMPT.md
